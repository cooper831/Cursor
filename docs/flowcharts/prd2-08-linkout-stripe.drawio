<mxfile host="app.diagrams.net" agent="7.0" pages="1">
  <diagram id="linkout" name="Link-out Stripe 流程">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="T" value="&lt;b&gt;Phase 2 · Link-out Stripe 支付流程&lt;/b&gt; — 4 泳道：用户 / App / 独立站 Web + Stripe / RevenueCat + 品牌后端" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="1080" height="30" as="geometry" />
        </mxCell>
        <mxCell id="L1" value="用户" style="swimlane;horizontal=0;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;swimlaneFillColor=#f8fbff;" parent="1" vertex="1">
          <mxGeometry x="40" y="60" width="200" height="740" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="App (RC SDK)" style="swimlane;horizontal=0;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;swimlaneFillColor=#f6fbf5;" parent="1" vertex="1">
          <mxGeometry x="240" y="60" width="200" height="740" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="独立站 Web + Stripe" style="swimlane;horizontal=0;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;swimlaneFillColor=#fffcf1;" parent="1" vertex="1">
          <mxGeometry x="440" y="60" width="200" height="740" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="RevenueCat + 品牌后端" style="swimlane;horizontal=0;startSize=28;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;swimlaneFillColor=#faf5fb;" parent="1" vertex="1">
          <mxGeometry x="640" y="60" width="200" height="740" as="geometry" />
        </mxCell>
        <mxCell id="S1" value="① 看到合规外部购买提示&#10;(Apple External Link 标准措辞)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="55" y="110" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="S2" value="② 展示跳转外部网页按钮&#10;+ 合规弹窗二次确认" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="255" y="180" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="S3" value="③ 点击 &quot;在网页购买&quot;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="55" y="240" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="S4" value="④ 构造 URL 携带&#10;app_user_id 参数" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="255" y="295" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="S5" value="⑤ 独立站 Checkout 页&#10;显示 Stripe Payment 元素" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="455" y="355" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="S6" value="⑥ 填支付信息并确认" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="55" y="415" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="S7" value="⑦ Stripe 处理扣款&#10;发送 stripe.subscription.created" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="455" y="470" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="S8" value="⑧ Stripe ↔ RC Web Billing 集成&#10;RC 自动创建/更新 Subscriber&#10;并授予 storage_pro" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#e8daef;strokeColor=#6a1b9a;fontSize=10;fontStyle=1;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="655" y="530" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="S9" value="⑨ RC 发 INITIAL_PURCHASE&#10;Webhook 到品牌后端入库" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#faf5fb;strokeColor=#9673a6;fontSize=10;fontStyle=2;dashed=1;dashPattern=4 3;" parent="1" vertex="1">
          <mxGeometry x="655" y="605" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="S10" value="⑩ 回到 App（深度链接 / 手动）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="55" y="665" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="S11" value="⑪ 调 Purchases.getCustomerInfo()&#10;检测到 storage_pro 已激活&#10;解锁存储 Pro ✅" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=10;fontStyle=1;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="255" y="720" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Legend" value="&lt;b&gt;图例&lt;/b&gt;&lt;br&gt;━━ 主链路&lt;br&gt;┄┄ Webhook（异步）&lt;br&gt;⚠️ 前置：Apple External Purchase&lt;br&gt;    Link 合规申请需先通过&lt;br&gt;⚠️ Stripe↔RC 集成需先配置" style="text;html=1;strokeColor=#b3b3b3;fillColor=#fafafa;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="860" y="60" width="220" height="130" as="geometry" />
