        <mxCell id="sh4" value="Dashboard 收入分析" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;" parent="Share" vertex="1">
          <mxGeometry x="780" y="40" width="280" height="30" as="geometry" />
