<mxfile host="app.diagrams.net" agent="7.0" pages="1">
  <diagram id="check" name="订阅权益验证">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="T" value="&lt;b&gt;订阅权益验证流程&lt;/b&gt; — 客户端走 CustomerInfo / 服务端走 user_entitlement" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="40" y="20" width="1080" height="30" as="geometry" />
        </mxCell>
        <mxCell id="L1" value="📱 客户端（UI 展示 / 功能门控）" style="swimlane;horizontal=1;startSize=32;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;swimlaneFillColor=#f6fbf5;" parent="1" vertex="1">
          <mxGeometry x="40" y="70" width="520" height="440" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="触发点：存储页打开 / App 启动 / 关键操作前" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" parent="L1" vertex="1">
          <mxGeometry x="20" y="45" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="Purchases.getCustomerInfo()" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;fontStyle=1;" parent="L1" vertex="1">
          <mxGeometry x="20" y="100" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="读取 customerInfo.entitlements.active[&quot;storage_pro&quot;]" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=10;strokeWidth=2;" parent="L1" vertex="1">
          <mxGeometry x="20" y="155" width="480" height="45" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="是否存在且 isActive?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" parent="L1" vertex="1">
          <mxGeometry x="140" y="220" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="✅ 解锁存储 Pro 功能&#10;（容量 / 云同步 / 导出 …）" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=10;fontStyle=1;strokeWidth=2;" parent="L1" vertex="1">
          <mxGeometry x="20" y="310" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="❌ 显示升级 CTA&#10;引导进入订阅方案页" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;strokeWidth=2;" parent="L1" vertex="1">
          <mxGeometry x="280" y="310" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="宽限期特别处理：&#10;billingIssueDetectedAt != null → 展示续费提醒" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#b8860b;fontSize=10;" parent="L1" vertex="1">
          <mxGeometry x="20" y="380" width="480" height="45" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="⚙️ 服务端（受控接口验权）" style="swimlane;horizontal=1;startSize=32;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;swimlaneFillColor=#faf5fb;" parent="1" vertex="1">
          <mxGeometry x="600" y="70" width="520" height="440" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="触发点：上传文件 / 超配额 / 敏感操作" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;" parent="L2" vertex="1">
          <mxGeometry x="20" y="45" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="查询 user_entitlement&#10;WHERE app_user_id=? AND entitlement_id='storage_pro'" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;" parent="L2" vertex="1">
          <mxGeometry x="20" y="100" width="480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="is_active=true AND expires_at &gt; now?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" parent="L2" vertex="1">
          <mxGeometry x="100" y="170" width="320" height="65" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="✅ 放行业务操作" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=11;fontStyle=1;strokeWidth=2;" parent="L2" vertex="1">
          <mxGeometry x="20" y="265" width="240" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="❌ 403 拒绝 + 引导订阅" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;strokeWidth=2;" parent="L2" vertex="1">
          <mxGeometry x="280" y="265" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="可选：关键操作前调 RC REST API 二次确认&#10;GET /v1/subscribers/{app_user_id}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#faf5fb;strokeColor=#9673a6;fontSize=10;fontStyle=2;dashed=1;dashPattern=4 3;" parent="L2" vertex="1">
          <mxGeometry x="20" y="330" width="480" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="对账保障：每日定时比对 user_entitlement vs RC REST" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#fff2cc;strokeColor=#b8860b;fontSize=10;" parent="L2" vertex="1">
          <mxGeometry x="20" y="390" width="480" height="35" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#1f2937;strokeWidth=1.5;endArrow=block;endFill=1;" parent="1" source="c1" target="c2" edge="1">
